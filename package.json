  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:rewards": "ts-node -r tsconfig-paths/register scripts/seed-rewards.ts",
    "seed:communities": "ts-node -r tsconfig-paths/register scripts/seed-communities.ts",
    "check:orphaned-users": "ts-node -r tsconfig-paths/register scripts/check-orphaned-users.ts",
    "cleanup:orphaned-users": "ts-node -r tsconfig-paths/register scripts/cleanup-orphaned-users.ts",
    "updatepfps": "ts-node -r tsconfig-paths/register scripts/updatepfps.ts",
    "migrate": "drizzle-kit push",
    "migrate:legacy": "ts-node -r tsconfig-paths/register lib/db/migrate.ts",
    "migrate:fix": "ts-node -r tsconfig-paths/register scripts/fix-migrations.ts",
    "migrate:sync": "ts-node -r tsconfig-paths/register scripts/sync-drizzle-migrations.ts",
    "migrate:check": "ts-node -r tsconfig-paths/register scripts/check-migrations.ts",
    "migrate:clean": "ts-node -r tsconfig-paths/register scripts/clean-duplicate-migrations.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
