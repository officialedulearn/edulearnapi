{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^lib/(.*)$": "<rootDir>/../lib/$1",
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^types/(.*)$": "<rootDir>/../types/$1"
  }
}
